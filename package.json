{
  "name": "ptcg-engine-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test:ui": "node tests/browser/smoke.mjs",
    "engine:build": "node scripts/build-engine.mjs",
    "engine": "node packages/engine/dist/worker.cjs",
    "test:engine": "node --import tsx --test packages/engine/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {"@progress/pako-esm": "1.0.1"},
  "devDependencies": {"@types/node": "^22.0.0", "esbuild": "^0.25.0", "tsx": "^4.20.0", "typescript": "^5.9.0", "@playwright/test": "^1.55.0"}
}
